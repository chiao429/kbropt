---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const title = `新申辦｜${SITE.name}`;
---

<BaseLayout
  title={title}
  description="新申辦專線與 LINE 諮詢入口。提供快速聯絡，協助安排最適合的方案。"
  canonicalPath="/apply"
>
  <div class="container">
    <section class="hero">
      <div class="hero-grid">
        <div class="reveal">
          <h1 class="h-title">新申辦專線與線上諮詢</h1>
          <p class="h-sub">想了解家中適合的上網方案？你可以直接撥打新申辦專線或加入 LINE 先詢問，快速確認需求與可用資源。</p>
          <div class="kpis">
            <div class="kpi">新申辦專線：{SITE.phoneDisplay}</div>
            <div class="kpi">LINE：點按即可加入</div>
            <div class="kpi">客服：{SITE.officialSupportDisplay}</div>
          </div>
          <div style="margin-top: 18px; display: flex; gap: 10px; flex-wrap: wrap;">
            <a class="btn btn-primary" href={SITE.phoneTel}>立即撥打</a>
            <a class="btn" href={SITE.lineUrl} rel="noopener" target="_blank">加入 LINE 諮詢</a>
          </div>
        </div>

        <aside class="card card-pad reveal">
          <div class="card-title">快速入口</div>
          <div class="cta-stack">
            <a class="btn btn-primary" href={SITE.phoneTel}>新申辦：{SITE.phoneDisplay}</a>
            <a class="btn" href={SITE.lineUrl} rel="noopener" target="_blank">請點我加入 LINE</a>
          </div>
          <p class="small" style="margin: 12px 0 0;">如果是「維修/沒訊號」或「續約/合約未到」，請改到對應頁面查看官方客服專線。</p>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="reveal">
        <h2>你可以先提供的資訊（加快協助速度）</h2>
        <div class="grid-3">
          <div class="feature">
            <h3>地區/社區</h3>
            <p>你所在的縣市、區域或社區名稱，方便快速確認可用資源。</p>
          </div>
          <div class="feature">
            <h3>使用情境</h3>
            <p>居家上班、遠距學習、遊戲、追劇或多裝置同時上網等。</p>
          </div>
          <div class="feature">
            <h3>希望的聯絡方式</h3>
            <p>電話快速確認，或先用 LINE 文字/圖片說明狀況。</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
